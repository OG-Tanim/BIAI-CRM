# ---------------------------------------------------------------------------
# BIAI CRM — every environment variable the application reads.
# Copy to `.env.local` for local development. Never commit a filled copy.
# ---------------------------------------------------------------------------

# Which Neon branch this process talks to. `production` uses DATABASE_URL,
# `testing` uses TEST_DATABASE_URL. Defaults to `testing` when unset so a
# local or preview process can never fall through to live data by accident.
DATABASE_BRANCH=testing

# Neon production branch. Holds the schema and zero rows, always.
# Schema changes may be pushed here; seed data may never be.
DATABASE_URL=postgresql://user:password@production-host/dbname?sslmode=require

# Neon testing branch. Seeding and demo data live here and only here.
TEST_DATABASE_URL=postgresql://user:password@testing-host/dbname?sslmode=require

# Public origin used by health checks and future absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Extraction (wired in S1; documented from S0 so no variable is a surprise)
# Server-side only. Never expose this to the browser.
OPENROUTER_API_KEY=
# OpenAI-compatible endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free-tier model id. Configuration, never a constant.
OPENROUTER_MODEL=
# Milliseconds one AI attempt may run before it fails as ai_unavailable.
# Applies to extraction, reply generation and the weekly summary alike.
# Optional; defaults to 45000 when unset or malformed.
OPENROUTER_TIMEOUT_MS=120000
# When 1, the extractor returns canned fixtures and makes no network call.
MOCK_AI=0
